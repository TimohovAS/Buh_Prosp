# Copy this file to .env and set secure values
DATABASE_URL=sqlite+aiosqlite:///./prospel.db
SECRET_KEY=replace-with-very-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_IDLE_EXPIRE_MINUTES=240
REFRESH_TOKEN_ABSOLUTE_EXPIRE_MINUTES=720
# Set to true only when the application is served over HTTPS
REFRESH_COOKIE_SECURE=false
